# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=info
CORS_ORIGINS=https://merchintell.onrender.com,https://merchintell.vercel.app,http://localhost:3000,http://localhost:5173

# Database Configuration
DATABASE_URL=sqlite:///./merchant_autopilot.db
# PostgreSQL production example:
# DATABASE_URL=postgresql://autopilot:autopilot@localhost:5432/merchant_autopilot

# AI Provider Configuration (Provider Abstraction)
AI_PROVIDER=mock # mock, openai, anthropic, gemini
AI_API_KEY=your_ai_api_key_here
AI_MODEL_NAME=gpt-4o-mini

# Razorpay Test Mode Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_MOCK_MODE=true

# Security Guardrails Defaults
MAX_DISCOUNT_PERCENT=30.0
MIN_GROSS_MARGIN_PERCENT=10.0
MAX_ORDER_QUANTITY=500
MAX_CASH_EXPOSURE=50000.0
CONFIDENCE_THRESHOLD=0.70
