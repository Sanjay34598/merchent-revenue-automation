# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=info

# Database Configuration
DATABASE_URL=sqlite:///./merchant_autopilot.db

# AI Provider Configuration (Provider Abstraction)
AI_PROVIDER=mock
AI_API_KEY=mock_key
AI_MODEL_NAME=mock-model

# Razorpay Test Mode Configuration
RAZORPAY_KEY_ID=rzp_test_mock_key
RAZORPAY_KEY_SECRET=mock_secret
RAZORPAY_WEBHOOK_SECRET=mock_webhook_secret
RAZORPAY_MOCK_MODE=true

# Security Guardrails Defaults
MAX_DISCOUNT_PERCENT=30.0
MIN_GROSS_MARGIN_PERCENT=10.0
MAX_ORDER_QUANTITY=500
MAX_CASH_EXPOSURE=50000.0
CONFIDENCE_THRESHOLD=0.70
